{
  "hooks": {
    "SessionStart": [{ "matcher": "startup|resume|clear|fork", "hooks": [{ "type": "command", "command": "glance-panel", "args": ["hook"], "timeout": 20 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "glance-panel", "args": ["hook"], "timeout": 20 }] }],
    "StopFailure": [{ "hooks": [{ "type": "command", "command": "glance-panel", "args": ["hook"], "timeout": 20 }] }]
  }
}
